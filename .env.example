# =============================================================================
# deep_agent_search 环境变量模板（示例文件，可以安全提交进 Git）
# =============================================================================
# 用法：复制一份改名为 .env（就在本文件旁边）：
#
#   Windows (PowerShell):  copy .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# 然后把你自己的真实密钥填进去。真正的 .env 已被 .gitignore 挡住，不会进仓库；
# 而本文件（.env.example）里没有任何真实密钥，所以可以放心提交。
# =============================================================================

# ---------- RAGFlow 知识库（可选项，不用就保持注释）----------
# RAGFLOW_API_URL=http://你的RAGFlow地址
# RAGFLOW_API_KEY=ragflow-你的密钥

# ---------- LLM 配置（DeepSeek，OpenAI 兼容接口）----------
# 代码里读取的是下面三个变量（见 agent/llm.py）：
#   DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY / LLM_DEEPSEEK
# 注意：DEEPSEEK_API_KEY 也可以放在系统环境变量里，.env 中留空即可。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_DEEPSEEK=deepseek-flash

# （备查）原阿里云百炼 DashScope 配置，如改用百炼可取消注释并同步修改 agent/llm.py
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=
# LLM_QWEN_PLUS=qwen3.6-flash

# ---------- Tavily 联网搜索 ----------
TAVILY_API_KEY=

# ---------- MySQL 数据库 ----------
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pharma_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
