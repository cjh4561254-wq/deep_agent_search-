# =============================================================================
# sql/ 目录下 docker compose 的环境变量模板（示例文件，可以安全提交进 Git）
# =============================================================================
# 用法：复制一份改名为 .env（就在本文件旁边）：
#
#   Windows (PowerShell):  copy sql\.env.example sql\.env
#   Linux / macOS:         cp sql/.env.example sql/.env
#
# 然后启动：docker compose -f sql/cps.yml up -d
# docker compose 会自动读取 compose 文件同级的 .env。
# 真正的 sql/.env 已被 .gitignore 挡住，不会进仓库。
# =============================================================================

# MySQL root 用户的密码（务必改成强密码）
MYSQL_ROOT_PASSWORD=

# 首次启动自动创建的数据库名
MYSQL_DATABASE=mydb

# 自动创建的普通用户（应用连接建议用它，而非 root）
MYSQL_USER=itwwy

# 普通用户密码
MYSQL_PASSWORD=
